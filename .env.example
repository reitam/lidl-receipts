# A felület jelszava. Ha üres, nincs jelszó – ilyenkor csak a hálózat védi.
LIDL_UI_PASSWORD=

# Csak akkor kell, ha a Lidl API-verzió emelése szükséges (401/426 hiba).
LIDL_APP_VERSION=

# A két perzisztens mappa (a compose projektmappájához képest).
# Szerveren megadhatsz abszolút útvonalat is, pl. /srv/lidl/data.
LIDL_DATA_PATH=./data
LIDL_OUTPUT_PATH=./nyugtak

# 0.0.0.0 = minden interfész; konkrét IP-re is köthető.
LIDL_BIND=0.0.0.0

# A fájlok tulajdonosa; a konténer ezzel a felhasználóval fut.
LIDL_UID=1000
LIDL_GID=1000
